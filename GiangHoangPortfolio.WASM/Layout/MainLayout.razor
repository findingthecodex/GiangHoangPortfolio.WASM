@inherits LayoutComponentBase
@using GiangHoangPortfolio.WASM.Services
@using GiangHoangPortfolio.WASM.Components
@inject CounterService CounterService

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<!-- GDPR cookie consent banner -->
<CookieConsent />

<MudLayout>

    <MudAppBar Color="Color.Transparent" Elevation="0">

        <!-- Hamburger: only visible on mobile (CSS-controlled) -->
        <MudIconButton Class="hamburger-btn" @onclick="ToggleMenu" Color="Color.Inherit">
            <MudIcon Icon="@(_menuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" />
        </MudIconButton>

        <!-- Desktop nav links -->
        @* <div class="nav-links-desktop"> *@
        @*     <MudButton Href="Home" Color="Color.Inherit">Om mig</MudButton> *@
        @*     <MudButton Href="journey" Color="Color.Inherit">Min resa</MudButton> *@
        @*     <MudButton Href="projects" Color="Color.Inherit">Projekt</MudButton> *@
        @*     <MudButton Href="youtube" Color="Color.Inherit">Youtube</MudButton> *@
        @*     <MudButton Href="cv" Color="Color.Inherit">CV</MudButton> *@
        @*     <MudButton Href="counter" Color="Color.Inherit">Statistik</MudButton> *@
        @*     <MudButton Href="contact" Color="Color.Inherit">Kontakt</MudButton> *@
        @*     <MudButton Href="QR" Color="Color.Inherit">QR</MudButton> *@
        @* </div> *@

        <MudSpacer />

    </MudAppBar>

    <!-- Mobile nav drawer (slide-down) -->
    <div class="mobile-nav @((_menuOpen ? "mobile-nav--open" : ""))">
        <MudButton Href="Home" Color="Color.Inherit" @onclick="CloseMenu">Om mig</MudButton>
        <MudButton Href="journey" Color="Color.Inherit" @onclick="CloseMenu">Min resa</MudButton>
        <MudButton Href="projects" Color="Color.Inherit" @onclick="CloseMenu">Projekt</MudButton>
        <MudButton Href="youtube" Color="Color.Inherit" @onclick="CloseMenu">Youtube</MudButton>
        <MudButton Href="cv" Color="Color.Inherit" @onclick="CloseMenu">CV</MudButton>
        <MudButton Href="counter" Color="Color.Inherit" @onclick="CloseMenu">Statistik</MudButton>
        <MudButton Href="contact" Color="Color.Inherit" @onclick="CloseMenu">Kontakt</MudButton>
        <MudButton Href="QR" Color="Color.Inherit" @onclick="CloseMenu">QR</MudButton>
    </div>

    <div class="hero-layout">

        <!-- Vänstersida: alltid synlig på desktop, centrerad på mobil -->
        <div class="profile-column">

            <div class="profile-card">
                <img src="images/IMG_92352.jpg" alt="Giang Hoang" />
            </div>

            <h2 class="profile-name">Giang Hoang</h2>
            <p class="profile-title">.NET / Blazor Developer</p>

            <nav class="profile-nav" aria-label="Profilnavigation">
                <MudButton Href="Home" Variant="Variant.Text">Om mig</MudButton>
                <MudButton Href="journey" Variant="Variant.Text">Min resa</MudButton>
                <MudButton Href="projects" Variant="Variant.Text">Projekt</MudButton>
                <MudButton Href="cv" Variant="Variant.Text">CV</MudButton>
                <MudButton Href="contact" Variant="Variant.Text">Kontakt</MudButton>
            </nav>

        </div>


        <!-- Mitten: byts per sida -->
        <div class="hero-content">
            @Body
        </div>

    </div>

</MudLayout>

<footer class="footer">
    © @DateTime.Now.Year Giang Hoang · FindingTheCode
</footer>


@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await CounterService.IncrementVisitsAsync();
    }
}