@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Color="Color.Transparent" Elevation="0">

        <MudText Typo="Typo.h6">GiangHoang.dev</MudText>

        <MudSpacer />

        <div style="display: flex; justify-content: center; flex: 10; gap: 12px;">
            <MudButton Href="/" Color="Color.Inherit">Om mig</MudButton>
            <MudButton Href="/underconstruction" Color="Color.Inherit">Min resa</MudButton>
            <MudButton Href="/underconstruction" Color="Color.Inherit">Projekt</MudButton>
            <MudButton Href="/youtube" Color="Color.Inherit">Youtube</MudButton>
            <MudButton Href="/cv" Color="Color.Inherit">CV</MudButton>
            <MudButton Href="/underconstruction" Color="Color.Inherit">Kontakt</MudButton>
        </div>

        <MudSpacer />

    </MudAppBar>

    <div class="hero-layout">

        <!-- Vänstersida: alltid synlig -->
        <div class="profile-column">
            <div class="profile-card">
                <img src="/images/IMG_92352.jpg" alt="Giang Hoang" />
            </div>
        </div>

        <!-- Mitten: byts per sida -->
        <div class="hero-content">
            @Body
        </div>

    </div>

</MudLayout>