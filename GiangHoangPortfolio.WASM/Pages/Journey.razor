@page "/journey"


<div class="journey-container">

    <h1 class="journey-title">Min resa</h1>
    <p class="journey-subtitle">
        Utbildning, projekt & milstolpar
    </p>

    @foreach (var item in JourneyItems)
    {
        <JourneyCard 
            Title="@item.Title"
            Date="@item.Date"
            Status="@item.Status"
            Type="@item.Type"
            Score="@item.Score"
            Description="@item.Description"
            Tags="@item.Tags" />
    }

</div>

