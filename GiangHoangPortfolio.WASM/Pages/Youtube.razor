@page "/youtube"

<div class="youtube-section">

    <h1 class="youtube-title">
        <a href="@("https://www.youtube.com/@FindingTheCode")" 
           target="_blank"
           style="text-decoration: none; color: inherit;">
       
            <i class="fa-brands fa-youtube"></i>
            FindingTheCode
        </a>
    </h1>
    
    <div style="margin-top: 3rem;"></div>

    <div class="youtube-embed">
        <iframe
            style="width: 100%; height: 60vh;"
            src="https://www.youtube.com/embed/RV6d4Kwj3Ic"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
        </iframe>
    </div>

    <div class="mt-4">
        <a href="@("https://www.youtube.com/watch?v=RV6d4Kwj3Ic")"
           target="_blank"
           class="mud-button mud-button-filled-primary">
            Öppna video på YouTube
        </a>
    </div>

</div>